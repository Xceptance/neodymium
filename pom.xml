<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.xceptance</groupId>
	<artifactId>neodymium-parent</artifactId>
	<version>5.6.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>neodymium-parent</name>
	<url>https://github.com/Xceptance/neodymium</url>
	<description>Parent aggregator for the Neodymium test automation ecosystem.</description>

	<organization>
		<name>Xceptance Software Technologies GmbH</name>
		<url>https://www.xceptance.com</url>
	</organization>

	<developers>
		<developer>
			<name>Xceptance Test Automation Team</name>
			<id>xceptance</id>
			<email>testautomation@xceptance.com</email>
			<organization>Xceptance Software Technologies GmbH</organization>
			<organizationUrl>https://www.xceptance.com/</organizationUrl>
			<timezone>+1</timezone>
		</developer>
	</developers>

	<licenses>
		<license>
			<name>MIT License</name>
			<url>http://www.opensource.org/licenses/mit-license.php</url>
		</license>
	</licenses>

	<scm>
		<connection>scm:git:git://github.com/Xceptance/neodymium.git</connection>
		<developerConnection>scm:git:ssh://github.com/Xceptance/neodymium.git</developerConnection>
		<url>https://github.com/Xceptance/neodymium/tree/master</url>
	</scm>

	<modules>
		<module>neodymium-test-server</module>
		<module>neodymium-core</module>
		<module>aura-manager</module>
		<module>neodymium-e2e-tests</module>
		<module>neodymium-classic</module>
	</modules>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<java.version>21</java.version>
		<maven.compiler.source.version>21</maven.compiler.source.version>
		<maven.compiler.target.version>21</maven.compiler.target.version>
		<maven.compiler.release>21</maven.compiler.release>

		<!-- Safe root-level -Dtest filtering across modules -->
		<surefire.failIfNoSpecifiedTests>false</surefire.failIfNoSpecifiedTests>
	</properties>

	<profiles>
		<!-- 1. Strictly classic JUnit 4 tests (Vintage engine) -->
		<profile>
			<id>neo-classic-junit4</id>
		</profile>

		<!-- 2. Strictly classic JUnit 5 tests (Jupiter engine) -->
		<profile>
			<id>neo-classic-junit5</id>
		</profile>

		<!-- 3. Direct in-memory unit tests (no browser, no Javalin server, no LLM calls) -->
		<profile>
			<id>unit-tests</id>
		</profile>

		<!-- 4. All modern tests: Non-Classic, Zero Real AI (deterministic & offline) -->
		<profile>
			<id>non-llm-tests</id>
		</profile>

		<!-- 5. All VÉRLA storefront UI and mock AI integration tests -->
		<profile>
			<id>verla-tests</id>
		</profile>

		<!-- 6. AI pipeline, replay, and integration tests using mocked LLM fixtures -->
		<profile>
			<id>ai-mock-tests</id>
		</profile>

		<!-- 7. Real LLM tests requiring API keys (LiveAPI, LiveLlm) -->
		<profile>
			<id>ai-live-tests</id>
		</profile>

		<!-- 8. AI Glance visual defect & baseline sandbox tests (legacy alias: aura-sandbox) -->
		<profile>
			<id>ai-sandbox</id>
		</profile>
		<profile>
			<id>aura-sandbox</id>
		</profile>

		<!-- 9. AI Manager Spring Boot hub test suite (legacy alias: aura-manager) -->
		<profile>
			<id>ai-manager</id>
		</profile>
		<profile>
			<id>aura-manager</id>
		</profile>

		<!-- 10. Fast sanity verification suite (< 60s) -->
		<profile>
			<id>smoke</id>
		</profile>
	</profiles>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.5.4</version>
					<configuration>
						<failIfNoSpecifiedTests>${surefire.failIfNoSpecifiedTests}</failIfNoSpecifiedTests>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
					<version>4.1.0</version>
					<configuration>
						<skip>true</skip>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>
